<div class="projects">
  {% assign categories = "Courses,Workshops" | split: "," %}

  {% for category in categories %}
    <a id="{{ category | strip }}" href=".#{{ category | strip }}">
      <h2 class="category">{{ category | strip }}</h2>
    </a>

    {% assign items = site.teaching | where: "category", category | sort: "importance" %}

    <div class="row row-cols-1 row-cols-md-3">
      {% for item in items %}
        {% include projects.liquid project=item %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
